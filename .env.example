# Server Port
PORT=3000

# ElevenLabs API Key (For Instant Voice Cloning & Multilingual Dubbing: Chinese -> Khmer)
# Get from https://elevenlabs.io
ELEVENLABS_API_KEY=

# ElevenLabs default voice_id used for Khmer line generation when no character-specific
# clone is available. Setting this switches line generation to the Gemini (emotion) +
# ElevenLabs (speech) pipeline. Find voice IDs at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=

# Google Gemini API Key (cinematic subtitle translation, character analysis, and
# per-line Khmer text emotion detection for voice generation)
# Get from https://aistudio.google.com/apikey — must start with AIza, not AQ.
GEMINI_API_KEY=

# Supabase (Optional: cloud accounts, job history, and character voice casts)
# Setup guide: docs/SUPABASE_SETUP.md — run supabase_schema.sql first.
# Use the SECRET key (sb_secret_...) or legacy service_role key. Never the anon/publishable key.
# Server-side only: never put this key in frontend code or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Storage bucket for uploaded character voices (created by supabase_schema.sql)
SUPABASE_VOICE_BUCKET=voice-casts
