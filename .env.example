# Server Port
PORT=3000

# ── VoxCPM2 voice cloning (voxcpm_server/, runs next to the studio) ──
# docker compose sets this to http://voxcpm:8000; a Colab/Kaggle link also works
VOXCPM_API_URL=
# Optional shared secret; set the same value on the voxcpm service
VOXCPM_API_KEY=

# ElevenLabs API Key (For Instant Voice Cloning & Multilingual Dubbing: Chinese -> Khmer)
# Get from https://elevenlabs.io
ELEVENLABS_API_KEY=

# ElevenLabs default voice_id used for Khmer line generation when no character-specific
# clone is available. Setting this switches line generation to the Gemini (emotion) +
# ElevenLabs (speech) pipeline. Find voice IDs at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=

# Google Gemini API Key (cinematic subtitle translation, character analysis, and
# per-line Khmer text emotion detection for voice generation)
# Get from https://aistudio.google.com/apikey — new keys start with AQ. (old ones with AIza); both work
GEMINI_API_KEY=

# Supabase (Optional: cloud accounts, job history, and character voice casts)
# Setup guide: docs/SUPABASE_SETUP.md — run supabase_schema.sql first.
# Use the SECRET key (sb_secret_...) or legacy service_role key. Never the anon/publishable key.
# Server-side only: never put this key in frontend code or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Storage bucket for uploaded character voices (created by supabase_schema.sql)
SUPABASE_VOICE_BUCKET=voice-casts

# ── Server / VPS mode (set automatically by the Docker image) ──
# Requires a login for every API call and admin rights for keys, files, updates.
# STUDIO_PUBLIC_MODE=1
# Server mode logs people in through the Telegram bot only. 1 = also allow email + password
# (then STUDIO_ADMIN_PASSWORD is REQUIRED: the built-in one is not safe online).
STUDIO_PASSWORD_LOGIN=0
STUDIO_ADMIN_PASSWORD=
# @username of the bot (no @) — shown on the sign-in screen as "open from Telegram"
STUDIO_BOT_USERNAME=
# 1 = anyone can create an account on the server (default 0 in server mode)
STUDIO_ALLOW_REGISTER=0

# ── Telegram Mini App login (studio opened from the bot) ──
# The bot's token (same as the bot's TELEGRAM_LOGIN_BOT_TOKEN): verifies the signed data
# Telegram gives the page, so people opened from the bot are logged in automatically.
STUDIO_TELEGRAM_BOT_TOKEN=
# Telegram user ids (comma separated) that become studio admins when they log in this way
STUDIO_TELEGRAM_ADMIN_IDS=
# 0 = only existing Telegram accounts may log in (default 1: created on first use)
STUDIO_TELEGRAM_SIGNUP=1
